# Example environment file for FZVis. Copy this to `.env` and fill
# in real values. Do NOT commit actual secret keys or API keys.

# ==============================================================================
# Security & Authentication
# ==============================================================================

# Secret key used by Flask for session signing, cookie encryption, 
# and token generation. Use a long, random string.
FLASK_SECRET_KEY=''

# Optional simple passcode used by the backend for lightweight access
# control. Leave it blank to skip passcode authentication.
FLASK_PASSCODE=''

# ==============================================================================
# AI / Large Language Model Integration
# ==============================================================================

# API key for NVIDIA Large Language Model integration used by the backend.
# You can obtain an API key from https://build.nvidia.com/models
# (Both LLM_API_KEY and NVIDIA_API_KEY are recognized).
LLM_API_KEY=''
# NVIDIA_API_KEY=''

# ==============================================================================
# Performance & In-Memory Cache Limits
# ==============================================================================

# Default item limit across in-memory LRU caches (default: 50).
# FZVIS_CACHE_SIZE=50

# Maximum number of original raw datasets kept in memory LRU cache (default: 50).
# FZVIS_INPUT_CACHE_SIZE=50

# Maximum number of decompressed compression results kept in memory LRU cache (default: 50).
# FZVIS_DECOMPRESSED_CACHE_SIZE=50

# ==============================================================================
# Resource Guardrails & Server Limits
# ==============================================================================

# Maximum number of concurrent compressor instances allowed per user/session (default: 10).
# This is broadcast to the frontend as the authoritative limit and enforced by the backend.
# FZVIS_MAX_COMPRESSOR_INSTANCES=10

# Maximum file upload size limit (e.g. '100MB', '500MB', '2GB', or raw bytes; default: '100MB').
# Alternatively, set FZVIS_MAX_UPLOAD_SIZE_MB with a number in megabytes (e.g. 100).
# FZVIS_MAX_UPLOAD_SIZE='100MB'
# FZVIS_MAX_UPLOAD_SIZE_MB=100

# ==============================================================================
# Storage Paths
# ==============================================================================

# Root directory path for storing saved case studies (default: './case_studies').
# FZVIS_CASE_STUDY_ROOT=''
