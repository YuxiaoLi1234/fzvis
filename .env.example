# Example environment file for the project. Copy this to `.env` and fill
# in real secret values. Do NOT commit actual secret keys or API keys.

# Secret key used by Flask for session signing, cookie encryption, 
# and CSRF protection. Use a long, random string.
FLASK_SECRET_KEY=''
# Optional simple passcode used by the backend for lightweight access
# control. Leave it blank to skip the passcode authentication.
FLASK_PASSCODE=''
# API key for NVIDIA Large Language Model integration the backend server 
# may use. You can get one from https://build.nvidia.com/models.
LLM_API_KEY=''
